<?xml version="1.0" encoding="utf-8" ?>
<Border xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="FlowlyFront.components.BottomNavigationBar" BackgroundColor="White" StrokeThickness="0" Padding="0">
    <Grid ColumnDefinitions="*, *, *, *" Padding="0,10" RowSpacing="5">
        <Button Grid.Column="0" BackgroundColor="Transparent" Clicked="OnHomeClicked" HorizontalOptions="Center" VerticalOptions="Center" Text="🏠" FontSize="24" />
        <Button Grid.Column="1" BackgroundColor="Transparent" Clicked="OnSearchClicked" HorizontalOptions="Center" VerticalOptions="Center" Text="🔍" FontSize="24" />
        <Button Grid.Column="2" BackgroundColor="Transparent" Clicked="OnTeamsClicked" HorizontalOptions="Center" VerticalOptions="Center" Text="👥" FontSize="24" />
        <Button Grid.Column="3" BackgroundColor="Transparent" Clicked="OnProfileClicked" HorizontalOptions="Center" VerticalOptions="Center" Text="👤" FontSize="24" />
    </Grid>
</Border>