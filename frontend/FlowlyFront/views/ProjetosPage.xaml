<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlowlyFront.views.ProjetosPage"
             BackgroundColor="#F0F0F0">
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Padding="20">
    <!-- Header -->
    <HorizontalStackLayout Grid.Row="0" Spacing="12" VerticalOptions="Center">
            <Button WidthRequest="10"
                    HeightRequest="10"
                    Clicked="OnBackClicked"
                    BackgroundColor="#ECECEC"
                    CornerRadius="12"
                    ImageSource="back.png"
                    Padding="0" />

            <Label x:Name="EquipeNomeLabel" Text="Nome da equipe" FontSize="22" FontAttributes="Bold" TextColor="#0E1F44" />
    </HorizontalStackLayout>

    <!-- Subheader -->
        <Label Grid.Row="1" Text="Projetos" FontSize="14" TextColor="#6B6B6B" Margin="0,6,0,6" />

        <!-- List -->
    <CollectionView x:Name="ProjetosCollection" Grid.Row="2" SelectionMode="None">
      <CollectionView.ItemsLayout>
        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
      </CollectionView.ItemsLayout>
      <CollectionView.EmptyView>
        <VerticalStackLayout Padding="12" Spacing="8">
          <Label Text="Nenhum projeto encontrado." TextColor="#6B6B6B" />
        </VerticalStackLayout>
      </CollectionView.EmptyView>
      <CollectionView.ItemTemplate>
        <DataTemplate>
          <Border BackgroundColor="White" Stroke="#337BFF" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14" Margin="0,6">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
              <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnProjetoTapped" CommandParameter="{Binding}" />
              </Grid.GestureRecognizers>
              <Label Grid.Row="0" Grid.Column="0" Text="{Binding nome}" FontAttributes="Bold" FontSize="16" TextColor="#0E1F44" />
              <Label Grid.Row="1" Grid.Column="0" Text="{Binding descricao}" FontSize="13" TextColor="#6B6B6B" />
              <Label Grid.RowSpan="2" Grid.Column="1" Text="•••" FontSize="20" TextColor="#A0A0A0" VerticalOptions="Center">
                <Label.GestureRecognizers>
                  <TapGestureRecognizer Tapped="OnProjetoMenuTapped" CommandParameter="{Binding}" />
                </Label.GestureRecognizers>
              </Label>
            </Grid>
          </Border>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>

    <!-- Message -->
    <Label x:Name="MessageLabel" Grid.Row="3" IsVisible="False" />

    <!-- Create Project Button -->
    <Button Grid.Row="4"
            Text="Criar projeto"
            Clicked="OnCriarProjetoClicked"
            BackgroundColor="#337BFF"
            TextColor="White"
            Margin="0,12,0,0" />
  </Grid>
</ContentPage>