<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlowlyFront.views.LoginPage"
             BackgroundColor="#F0F0F0"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="30,80,30,30" Spacing="24">

            <VerticalStackLayout Spacing="8" Margin="0,0,0,30">
                <Label Text="Bem-vindo!"
                       FontAttributes="Bold"
                       FontSize="32"
                       TextColor="#1A1A1A"
                       HorizontalOptions="Center" />
                <Label Text="Entre na sua conta para continuar"
                       FontSize="16"
                       TextColor="#6B7280"
                       HorizontalOptions="Center"
                       Margin="0,5,0,0" />
            </VerticalStackLayout>

            <Frame x:Name="MessageFrame"
                   CornerRadius="12"
                   Padding="15,12"
                   BackgroundColor="#FEE2E2"
                   BorderColor="#FCA5A5"
                   HasShadow="True"
                   IsVisible="False"
                   Margin="0,0,0,10">
                <Label x:Name="MessageLabel"
                       Text=""
                       FontSize="14"
                       TextColor="#DC2626"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Frame>

            <VerticalStackLayout Spacing="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Email"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#374151"
                           Margin="5,0,0,0" />
                    <Frame CornerRadius="12"
                           Padding="15,0"
                           BackgroundColor="White"
                           BorderColor="#E5E7EB"
                           HasShadow="True"
                           HeightRequest="56">
                        <Entry x:Name="EmailEntry"
                               Placeholder="seu@email.com"
                               Keyboard="Email"
                               TextColor="#111827"
                               PlaceholderColor="#9CA3AF"
                               VerticalOptions="Center"
                               FontSize="16" />
                    </Frame>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Senha"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#374151"
                           Margin="5,0,0,0" />
                    <Frame CornerRadius="12"
                           Padding="15,0,5,0"
                           BackgroundColor="White"
                           BorderColor="#E5E7EB"
                           HasShadow="True"
                           HeightRequest="56">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Entry x:Name="PasswordEntry"
                                   Grid.Column="0"
                                   Placeholder="Digite sua senha"
                                   IsPassword="True"
                                   TextColor="#111827"
                                   PlaceholderColor="#9CA3AF"
                                   VerticalOptions="Center"
                                   FontSize="16" />
                            <Button x:Name="TogglePasswordButton"
                                    Grid.Column="1"
                                    BackgroundColor="Transparent"
                                    ImageSource="eye.png"
                                    WidthRequest="10"
                                    HeightRequest="10"
                                    Padding="0"
                                    Margin="5,0,0,0"
                                    Clicked="OnTogglePasswordClicked" />
                        </Grid>
                    </Frame>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="12" Margin="0,20,0,0">
                <Button Text="Entrar"
                        x:Name="LoginButton"
                        BackgroundColor="#337BFF"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="12"
                        HeightRequest="56"
                        Margin="0,0,0,0" />

                <Button Text="Criar conta"
                        x:Name="CreateAccountButton"
                        BackgroundColor="White"
                        TextColor="#337BFF"
                        BorderColor="#337BFF"
                        BorderWidth="2"
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="12"
                        HeightRequest="56"
                        Margin="0,0,0,0" />
            </VerticalStackLayout>

            <VerticalStackLayout VerticalOptions="EndAndExpand"
                                 HorizontalOptions="Center"
                                 Spacing="8"
                                 Margin="0,50,0,20">
                <Label Text="made by"
                       FontSize="13"
                       TextColor="#6B7280"
                       HorizontalOptions="Center"/>
                <Image Source="logo.png"
                       HeightRequest="28"
                       Opacity="0.8"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
