<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlowlyFront.views.AccountPage"
             BackgroundColor="#F0F0F0">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header com botão voltar -->
            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                <Button WidthRequest="10"
                        HeightRequest="10"
                        Clicked="OnBackClicked"
                        BackgroundColor="#ECECEC"
                        CornerRadius="12"
                        ImageSource="back.png"
                        Padding="0" />
                <Label Text="Minha conta" FontSize="22" FontAttributes="Bold" TextColor="#0E1F44" />
            </HorizontalStackLayout>

            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                <Label x:Name="GreetingLabel" Text="Olá, Usuário!" FontSize="24" FontAttributes="Bold" TextColor="#0E1F44" HorizontalOptions="Center" />
                <Label Text="Boas vindas" FontSize="14" TextColor="#6B6B6B" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Frame CornerRadius="12" Padding="16" BackgroundColor="White" HasShadow="False" BorderColor="#337BFF">
                <VerticalStackLayout Spacing="12">

                    <!-- Meus dados -->
                    <Grid Padding="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Source="config.png" WidthRequest="28" HeightRequest="28" Grid.Column="0" />
                        <Label Text="Meus dados" VerticalOptions="Center" FontSize="16" TextColor="#0E1F44" Grid.Column="1" Padding="10" />
                        <Label Text="›" TextColor="#A0A0A0" VerticalOptions="Center" Grid.Column="2" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMeusDadosTapped" />
                        </Grid.GestureRecognizers>
                    </Grid>

                    <!-- Sair -->
                    <Grid Padding="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="logout.png" WidthRequest="28" HeightRequest="28" Grid.Column="0" />
                        <Button Text="Sair" BackgroundColor="Transparent" TextColor="#E04B4B" FontAttributes="Bold" Grid.Column="1" Clicked="OnLogoutClicked" HorizontalOptions="Start" />
                    </Grid>

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
