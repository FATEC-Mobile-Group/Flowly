<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlowlyFront.views.MeusDadosPage"
             BackgroundColor="#F0F0F0">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                <Label Text="Meus dados" FontSize="24" FontAttributes="Bold" TextColor="#0E1F44" HorizontalOptions="Center" />
                <Label Text="Informações básicas da sua conta" FontSize="14" TextColor="#6B6B6B" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Frame CornerRadius="12" Padding="16" BackgroundColor="White" HasShadow="False" BorderColor="#337BFF">
                <VerticalStackLayout Spacing="12">
                    <!-- Nome -->
                    <Grid Padding="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="profile.png" WidthRequest="28" HeightRequest="28" Grid.Column="0" />
                        <Label x:Name="NomeLabel" Grid.Column="1" VerticalOptions="Center" FontSize="16" TextColor="#0E1F44" Text="Nome: -" />
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#EEE" />

                    <!-- Email -->
                    <Grid Padding="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="email.png" WidthRequest="28" HeightRequest="28" Grid.Column="0" />
                        <Label x:Name="EmailLabel" Grid.Column="1" VerticalOptions="Center" FontSize="16" TextColor="#0E1F44" Text="Email: -" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Alterar senha -->
            <Frame CornerRadius="12" Padding="16" BackgroundColor="White" HasShadow="False" BorderColor="#337BFF">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Alterar senha" FontSize="18" FontAttributes="Bold" TextColor="#0E1F44" />
                    <Label x:Name="ChangePasswordMessage" Text="" TextColor="#2E7D32" IsVisible="False" />
                    <Entry x:Name="NovaSenhaEntry" Placeholder="Nova senha" IsPassword="True" TextColor="Black" />
                    <Entry x:Name="ConfirmarSenhaEntry" Placeholder="Repetir nova senha" IsPassword="True" TextColor="Black" />
                    <Button Text="Alterar senha" Clicked="OnChangePasswordClicked" BackgroundColor="#337BFF" TextColor="White" />
                </VerticalStackLayout>
            </Frame>

            <Button Text="Fechar" Clicked="OnCloseClicked" BackgroundColor="#337BFF" TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>