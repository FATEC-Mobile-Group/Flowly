<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlowlyFront.views.CriarEquipePage"
             BackgroundColor="#F5F5F5">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label x:Name="HeaderLabel" Text="Criar equipe" FontSize="26" FontAttributes="Bold" TextColor="#0E1F44" />

            <VerticalStackLayout Spacing="8">
                <Label Text="Nome da equipe" FontSize="15" TextColor="#0E1F44" />
                <Border Stroke="#337BFF" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="10">
                    <Entry x:Name="NomeEntry" Placeholder="Digite o nome da equipe..." FontSize="16" TextColor="#0E1F44" PlaceholderColor="#8A8F98" BackgroundColor="White"/>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Descrição" FontSize="15" TextColor="#0E1F44" />
                <Border Stroke="#337BFF" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="10">
                    <Entry x:Name="DescricaoEntry" Placeholder="Descrição da equipe..." FontSize="16" TextColor="#0E1F44" PlaceholderColor="#8A8F98" BackgroundColor="White"/>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Possui vínculo empresarial?" FontSize="15" TextColor="#0E1F44" />
                <HorizontalStackLayout Spacing="20">
                    <RadioButton x:Name="VinculoSimRadio" Content="Sim" GroupName="VinculoGroup" CheckedChanged="OnVinculoCheckedChanged" TextColor="#0E1F44" />
                    <RadioButton x:Name="VinculoNaoRadio" Content="Não" GroupName="VinculoGroup" IsChecked="True" CheckedChanged="OnVinculoCheckedChanged" TextColor="#0E1F44" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Vínculo" FontSize="15" TextColor="#0E1F44" />
                <Border Stroke="#337BFF" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="10">
                    <Entry x:Name="VinculoEntry" Placeholder="Digite o CNPJ ou empresa..." IsEnabled="False" FontSize="16" TextColor="#0E1F44" PlaceholderColor="#8A8F98" BackgroundColor="White" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Convidados" FontSize="15" TextColor="#0E1F44" />
                <Border Stroke="#337BFF" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="10">
                    <Editor x:Name="ConvidadosEditor" HeightRequest="160" Placeholder="emails separados por vírgula" FontSize="16" TextColor="#0E1F44" PlaceholderColor="#8A8F98" BackgroundColor="White" />
                </Border>
            </VerticalStackLayout>

            <Label x:Name="MessageLabel" IsVisible="False" FontSize="14" />

            <Button x:Name="ConfirmButton" Text="Criar equipe"
                    Clicked="OnCriarEquipeConfirmClicked"
                    BackgroundColor="#337BFF"
                    TextColor="White"
                    CornerRadius="10"
                    FontSize="16"
                    HeightRequest="48" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>